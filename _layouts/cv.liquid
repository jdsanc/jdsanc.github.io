---
layout: default
---
{% assign cv = site.data.cv.cv %}
<article class="cv">
  <header class="cv-header">
    <h1>{{ page.title }}</h1>
    <p>{{ cv.name }}<br>{{ cv.label }} <span aria-hidden="true">·</span> {{ cv.location }}</p>
    {% if cv.summary %}<p>{{ cv.summary }}</p>{% endif %}
  </header>
  {% for section in cv.sections %}
  <section class="cv-section" aria-labelledby="cv-{{ section[0] | slugify }}">
    <h2 id="cv-{{ section[0] | slugify }}">{{ section[0] }}</h2>
    <ul class="cv-entries">
      {% for entry in section[1] %}
      <li class="cv-entry">
        {% assign entry_title = entry.position | default: entry.title | default: entry.name | default: entry.institution %}
        <h3>{% if entry.url %}<a href="{{ entry.url }}">{{ entry_title }}</a>{% else %}{{ entry_title }}{% endif %}</h3>
        {% if entry.company %}<p>{{ entry.company }}</p>{% endif %}
        {% if entry.studyType or entry.area %}<p>{{ entry.studyType }}{% if entry.studyType and entry.area %} — {% endif %}{{ entry.area }}</p>{% endif %}
        {% if entry.awarder %}<p>{{ entry.awarder }}</p>{% endif %}
        {% if entry.issuer %}<p>{{ entry.issuer }}</p>{% endif %}
        {% if entry.location or entry.start_date or entry.date %}
        <p class="cv-meta">{% if entry.location %}{{ entry.location }}{% if entry.start_date or entry.date %} <span aria-hidden="true">·</span> {% endif %}{% endif %}{% if entry.start_date %}{{ entry.start_date }}{% if entry.end_date %} – {{ entry.end_date }}{% endif %}{% elsif entry.date %}{{ entry.date }}{% endif %}</p>
        {% endif %}
        {% if entry.summary %}<p>{{ entry.summary }}</p>{% endif %}
        {% if entry.keywords %}<p>{{ entry.keywords }}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
</article>
