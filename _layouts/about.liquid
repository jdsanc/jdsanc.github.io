---
layout: default
---
<section class="cover" aria-labelledby="cover-name">
  <div class="cover-heading">
    <p class="subject">Chemistry &amp; materials science</p>
    <h1 id="cover-name">{{ site.title | escape }}</h1>
  </div>
  <picture class="portrait">
    <source srcset="{{ '/assets/img/headshot.webp' | relative_url }}" type="image/webp">
    <img src="{{ '/assets/img/headshot.png' | relative_url }}" width="736" height="736" alt="Portrait of Jesus Diaz Sanchez">
  </picture>
  <p class="affiliation">{{ page.subtitle }}</p>
  <div class="research-summary">{{ content }}</div>
  <nav class="contact-links" aria-label="Contact and profiles">
      <a href="mailto:{{ site.data.socials.email }}">Email</a>
      <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>
      <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a>
      <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/">LinkedIn</a>
  </nav>
</section>

<section class="work-section" aria-labelledby="publications-heading">
  <header class="section-header">
    <h2 id="publications-heading">Selected publications</h2>
    <a class="editorial-link" href="{{ '/publications/' | relative_url }}">Publications <span aria-hidden="true">→</span></a>
  </header>
  {% include publication-list.liquid limit=2 %}
</section>
