---
layout: default
---
<div class="home-intro">
  <img class="headshot" src="{{ '/assets/img/headshot.png' | relative_url }}" width="136" height="136" alt="Jesus Diaz Sanchez">
  <header class="intro">
    <h1>{{ site.title }}</h1>
    <p class="affiliation">{{ page.subtitle }}</p>
    <div class="research-summary">{{ content }}</div>
    <nav class="primary-links" aria-label="Contact and profiles">
      <a href="mailto:{{ site.data.socials.email }}">Email</a>
      <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Scholar</a>
      <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>
      <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/">LinkedIn</a>
      <a href="{{ '/cv/' | relative_url }}">CV</a>
    </nav>
  </header>
</div>
<section class="selected-publications" aria-labelledby="publications-heading">
  <h2 id="publications-heading">Selected publications</h2>
  <ol class="publication-list">
    {% for publication in site.data.publications %}
    <li class="publication">
      <h3><a href="{{ publication.url }}">{{ publication.title }}</a></h3>
      <p class="publication-authors">{{ publication.authors }}</p>
      <p class="publication-meta">{{ publication.venue }} <span aria-hidden="true">·</span> {{ publication.year }}</p>
    </li>
    {% endfor %}
  </ol>
  <p class="all-publications"><a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">All publications <span aria-hidden="true">↗</span></a></p>
</section>
