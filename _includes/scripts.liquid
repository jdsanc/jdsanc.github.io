<script defer src="{{ '/assets/js/no_defer.js' | relative_url | bust_file_cache }}"></script>
<script defer src="{{ '/assets/js/common.js' | relative_url | bust_file_cache }}"></script>
<script defer src="{{ '/assets/js/copy_code.js' | relative_url | bust_file_cache }}"></script>

{% if site.enable_progressbar %}
  <script defer src="{{ '/assets/js/progress-bar.js' | relative_url | bust_file_cache }}"></script>
{% endif %}

{% if site.back_to_top %}
  <script defer src="{{ '/assets/js/vanilla-back-to-top.min.js' | relative_url | bust_file_cache }}"></script>
  <script>
    window.addEventListener("DOMContentLoaded", function () {
      if (typeof addBackToTop === "function") addBackToTop();
    });
  </script>
{% endif %}
