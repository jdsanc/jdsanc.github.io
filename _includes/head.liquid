<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% capture document_title %}{% if page.url != '/' %}{{ page.title }} · {% endif %}{{ site.title }}{% endcapture %}
<title>{{ document_title | escape }}</title>
<meta name="description" content="{{ page.description | default: site.description | strip | escape }}">
<meta name="author" content="{{ site.title | escape }}">
<meta name="color-scheme" content="light">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; form-action 'none'; script-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; frame-src 'none';">
<link rel="icon" type="image/png" href="{{ '/assets/img/favicon.png' | relative_url }}">
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url }}">
<link rel="canonical" href="{{ page.url | replace: 'index.html', '' | absolute_url }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ document_title | escape }}">
<meta property="og:description" content="{{ page.description | default: site.description | strip | escape }}">
<meta property="og:url" content="{{ page.url | absolute_url }}">
